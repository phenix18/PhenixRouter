# Toutes ces variables sont OPTIONNELLES : les clés peuvent aussi être ajoutées depuis le tableau de bord.
# Plusieurs clés pour un même fournisseur : séparez-les par des virgules (rotation automatique).

PHENIX_PASSWORD=            # mot de passe du tableau de bord (sinon généré au 1er lancement)
PHENIX_API_KEY=             # clé cliente pour /v1 (sinon générée au 1er lancement)
PHENIX_DATA_DIR=            # défaut : ~/.phenixrouter
HOST=127.0.0.1              # 0.0.0.0 pour exposer (Docker le fait déjà)
PORT=20128

GROQ_API_KEY=
CEREBRAS_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=
MISTRAL_API_KEY=
NVIDIA_API_KEY=
GITHUB_MODELS_TOKEN=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
HF_TOKEN=
SAMBANOVA_API_KEY=
TOGETHER_API_KEY=
COHERE_API_KEY=
ZHIPU_API_KEY=
SILICONFLOW_API_KEY=
